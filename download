# BIDCG Coaching Centre — static site
# Apache / cPanel only. Safe to delete if your host is Netlify, Vercel or nginx.

# --- Legacy page redirects (old URLs -> one-page anchors) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^about-us(\.html)?/?$   /#about      [R=301,L]
  RewriteRule ^about/?$               /#about      [R=301,L]
  RewriteRule ^courses(\.html)?/?$    /#courses    [R=301,L]
  RewriteRule ^gallery(\.html)?/?$    /#gallery    [R=301,L]
  RewriteRule ^admission(-form)?(\.html)?/?$ /#admission [R=301,L]
  RewriteRule ^contact(-us)?(\.html)?/?$     /#contact   [R=301,L]
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Caching ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 7 days"
  ExpiresByType application/javascript    "access plus 7 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
</IfModule>

# --- Declare the charset for HTML ---
AddDefaultCharset UTF-8
